# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these values from your Supabase project settings
# Visit: https://app.supabase.com → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima

# Optional: Service role key for server-side operations (keep secret)
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# ============================================================================
# API Configuration
# ============================================================================

NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ============================================================================
# Optional: External Services
# ============================================================================

# Mapbox (for map features)
# NEXT_PUBLIC_MAPBOX_TOKEN=seu-token-mapbox

# Sentry (for error tracking)
# NEXT_PUBLIC_SENTRY_DSN=seu-sentry-dsn

# Google Analytics
# NEXT_PUBLIC_GA_ID=seu-google-analytics-id

# ============================================================================
# Environment
# ============================================================================

NODE_ENV=development
